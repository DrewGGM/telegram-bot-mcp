{
  "name": "telegram-bot-mcp",
  "version": "0.3.0",
  "description": "Telegram ↔ Claude Code bridge: control your PC's AI agent sessions, files and terminals from Telegram, with hard security guardrails.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "mcp": "tsx src/mcp/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "smoke:guardrail": "node scripts/smoke-guardrail.mjs --with-live",
    "smoke:turn": "node scripts/smoke-turn.mjs",
    "smoke:mcp": "node scripts/smoke-mcp-live.mjs",
    "smoke:global": "node scripts/smoke-global-bridge.mjs",
    "smoke:reply": "node scripts/smoke-reply.mjs",
    "register:global": "node scripts/register-global-mcp.mjs",
    "setup": "pwsh -File scripts/setup.ps1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "pino": "^9.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
