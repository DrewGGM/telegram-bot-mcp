# Telegram bot token from @BotFather (required).
BOT_TOKEN=123456789:AA...your-token-here

# Optional: credentials from https://my.telegram.org, used ONLY to run a local
# Bot API server. With it, files up to 2000 MB are sent untouched instead of
# being compressed or split (the cloud Bot API caps uploads at 50 MB).
# Leave blank to skip; the bot works fine without them.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
